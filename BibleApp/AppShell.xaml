<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BibleApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:BibleApp.Pages">

    <!-- Bottom tabs for your 4 screens -->
    <TabBar>
        <ShellContent Route = "Home" Title="Home" ContentTemplate="{DataTemplate pages:MainPage}" />
        <ShellContent Route = "Books" Title="Books" ContentTemplate="{DataTemplate pages:BooksPage}" />
        <ShellContent Route = "Favorites" Title="Favorites" ContentTemplate="{DataTemplate pages:FavoritesPage}" />
        <ShellContent Route = "Settings" Title="Settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
        
        
    </TabBar>

</Shell>
