<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BibleApp.Pages.ReadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Read">

    <Grid>
        

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label x:Name="ChapterTitleLabel"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Label x:Name="ChapterContentLabel"
                       FontSize="18"
                       LineBreakMode="WordWrap">

                    <Label.GestureRecognizers>
                        <SwipeGestureRecognizer
                         Direction="Left"
                         Swiped="OnSwipedLeft" />

                        <SwipeGestureRecognizer
                          Direction="Right"
                          Swiped="OnSwipedRight" />
                    </Label.GestureRecognizers>

                </Label>
                <!-- Navigation buttons -->
                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Button Text="◀ Previous" Clicked="OnPreviousClicked"/>
                    <Button Text="Next ▶" Clicked="OnNextClicked"/>
                </HorizontalStackLayout>
                <!-- Add to Favorites -->
                <Button Text="☆ Add to Favorites" Clicked="OnAddFavoriteClicked" HorizontalOptions="Center" Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
