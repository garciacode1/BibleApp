<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BibleApp.Pages.ReadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Read">

    <ScrollView>
        <VerticalStackLayout Padding="20">
            <!--  chapter title -->
            <Label x:Name="ChapterTitleLabel"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Text="Loading..."/>
            <!--  chapter content -->
            <Label x:Name="ChapterContentLabel"
                   FontSize="18"
                   LineBreakMode="WordWrap"
                   TextColor="Black"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
