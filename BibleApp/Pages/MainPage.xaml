<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BibleApp.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Bible GPT">
    <Grid>
        <!-- background image -->
        <Image Source="main_image.png"
               Aspect="AspectFill"
               Opacity="0.3"
               ZIndex="0" 
        />

    <!-- Scrollable container for all content -->
     <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- title -->
            <Label Text="BIBLE - GPT"
                   FontSize="40"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"
                   HorizontalOptions="Center"
                   TextColor="Purple"
            />
            <Label Text="Digital Bible accesible for everyone!"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"
                   TextDecorations="Underline"
                   TextColor="Purple"
                   
            />
            <Label Text="You are not sure where to start?"
                       FontAttributes="Italic"
                       HorizontalOptions="Center"
                       Padding="0,30,0,0"
                       
                       
            />
           
            <!-- read sequentally space -->
            <Border Stroke="#D9D9D9" StrokeShape="RoundRectangle 12"
                    BackgroundColor="Beige">
                <VerticalStackLayout Padding="8" Spacing="18">
                    <Label Text="Read Sequentially"
                           FontAttributes="Bold"
                           FontSize="18" />
                    <Label Text="Read sequentially allows you to start your journey from the very beggining of the Bible!"
                           FontSize="14"
                           TextColor="#666" />
                    <Label FontSize="13"
                               TextColor="#666"
                               Text="Click to start reading from Genesis 1"/>
                                        
                    <Button Text="Start Reading"
                            Clicked="OnReadSequentiallyClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- footer -->
            <Label Text="Navigation:" FontAttributes="Italic" />
            <Label Text="• Tap the book icon below to select a specific book."
                   FontSize="12" TextColor="#666" />
            

        </VerticalStackLayout>
    </ScrollView>
   </Grid>
</ContentPage>

